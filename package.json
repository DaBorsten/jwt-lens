{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "jwt-lens",
  "title": "JWT Lens",
  "description": "Decode Your JSON Web Tokens – extract the header and data information from a JWT",
  "icon": "jwt.png",
  "author": "DaBorsten",
  "categories": [
    "Data",
    "Developer Tools",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "jwt-view",
      "title": "Decode a JWT",
      "description": "Decode and inspect the contents of a JWT",
      "mode": "view",
      "arguments": [
        {
          "name": "token",
          "placeholder": "Paste JWT",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "jose": "^6.2.8",
    "raycast-hooks": "^1.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.2.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "react-devtools": "6.1.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "private": false,
  "allowScripts": {
    "electron@23.3.13": true,
    "esbuild@0.27.7": true
  }
}
